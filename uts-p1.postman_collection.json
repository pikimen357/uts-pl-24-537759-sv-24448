{
  "info": {
    "name": "UTS P1 API",
    "description": "Koleksi endpoint API Buku (Laravel + Sanctum). Jalankan Login terlebih dahulu agar token tersimpan otomatis.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      { "key": "token", "value": "{{token}}", "type": "string" }
    ]
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8000/api" },
    { "key": "token", "value": "" }
  ],
  "item": [
    {
      "name": "1. Login",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
              "const res = pm.response.json();",
              "if (res.token) { pm.collectionVariables.set('token', res.token); }"
            ]
          }
        }
      ],
      "request": {
        "auth": { "type": "noauth" },
        "method": "POST",
        "header": [
          { "key": "Accept", "value": "application/json" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"password\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{base_url}}/login",
          "host": ["{{base_url}}"],
          "path": ["login"]
        }
      },
      "response": []
    },
    {
      "name": "2. Index (tampil semua)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": ["pm.test('Status 200', function () { pm.response.to.have.status(200); });"]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [{ "key": "Accept", "value": "application/json" }],
        "url": {
          "raw": "{{base_url}}/buku",
          "host": ["{{base_url}}"],
          "path": ["buku"]
        }
      },
      "response": []
    },
    {
      "name": "3. Show (tampil satu)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": ["pm.test('Status 200', function () { pm.response.to.have.status(200); });"]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [{ "key": "Accept", "value": "application/json" }],
        "url": {
          "raw": "{{base_url}}/buku/1",
          "host": ["{{base_url}}"],
          "path": ["buku", "1"]
        }
      },
      "response": []
    },
    {
      "name": "4. Store (tambah)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 201', function () { pm.response.to.have.status(201); });",
              "const res = pm.response.json();",
              "if (res.data && res.data.id) { pm.collectionVariables.set('buku_id', res.data.id); }"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Accept", "value": "application/json" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"judul\": \"Laravel Dasar\",\n  \"penulis\": \"Budi\",\n  \"tahun_terbit\": 2024,\n  \"stok\": 10\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{base_url}}/buku",
          "host": ["{{base_url}}"],
          "path": ["buku"]
        }
      },
      "response": []
    },
    {
      "name": "5. Update (ubah)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": ["pm.test('Status 200', function () { pm.response.to.have.status(200); });"]
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Accept", "value": "application/json" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"judul\": \"Laravel Lanjutan\",\n  \"penulis\": \"Budi\",\n  \"tahun_terbit\": 2025,\n  \"stok\": 20\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{base_url}}/buku/{{buku_id}}",
          "host": ["{{base_url}}"],
          "path": ["buku", "{{buku_id}}"]
        }
      },
      "response": []
    },
    {
      "name": "6. Destroy (hapus)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": ["pm.test('Status 200', function () { pm.response.to.have.status(200); });"]
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "header": [{ "key": "Accept", "value": "application/json" }],
        "url": {
          "raw": "{{base_url}}/buku/{{buku_id}}",
          "host": ["{{base_url}}"],
          "path": ["buku", "{{buku_id}}"]
        }
      },
      "response": []
    },
    {
      "name": "7. Logout",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": ["pm.test('Status 200', function () { pm.response.to.have.status(200); });"]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Accept", "value": "application/json" }],
        "url": {
          "raw": "{{base_url}}/logout",
          "host": ["{{base_url}}"],
          "path": ["logout"]
        }
      },
      "response": []
    },
    {
      "name": "Error: Store validasi gagal (422)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": ["pm.test('Status 422', function () { pm.response.to.have.status(422); });"]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Accept", "value": "application/json" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{base_url}}/buku",
          "host": ["{{base_url}}"],
          "path": ["buku"]
        }
      },
      "response": []
    },
    {
      "name": "Error: Index tanpa token (401)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": ["pm.test('Status 401', function () { pm.response.to.have.status(401); });"]
          }
        }
      ],
      "request": {
        "auth": { "type": "noauth" },
        "method": "GET",
        "header": [{ "key": "Accept", "value": "application/json" }],
        "url": {
          "raw": "{{base_url}}/buku",
          "host": ["{{base_url}}"],
          "path": ["buku"]
        }
      },
      "response": []
    }
  ]
}
